# Database
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Auth
JWT_SECRET=minimum-32-caracteres-aleatoires

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OCR - Extracteurs (au moins 1 requis)
# Claude API (Vision, priorité 1)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API (fallback pour PaddleOCR structuration)
OPENAI_API_KEY=your_openai_api_key_here

OCR_API_KEY=ocr-api-key
PADDLE_OCR_SERVICE_URL=paddle-ocr-service-url

# PaddleOCR HuggingFace Space (optionnel, défaut: PaddlePaddle/PaddleOCR)
HUGGINGFACE_PADDLE_SPACE=PaddlePaddle/PaddleOCR

# Supabase Storage (pour stockage fichiers factures)
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
